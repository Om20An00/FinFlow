{
  "realm": "finflow",
  "enabled": true,
  "displayName": "FinFlow",
  "sslRequired": "none",
  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "loginWithEmailAllowed": true,
  "resetPasswordAllowed": true,
  "accessTokenLifespan": 1800,
  "ssoSessionIdleTimeout": 36000,
  "ssoSessionMaxLifespan": 86400,
  "roles": {
    "realm": [
      {
        "name": "USER",
        "description": "Customer: create payments, view own wallet"
      },
      {
        "name": "MERCHANT",
        "description": "Merchant: receive payments, view settlement and analytics"
      },
      {
        "name": "ADMIN",
        "description": "Operations: freeze wallets, audit logs, analytics"
      }
    ]
  },
  "clients": [
    {
      "clientId": "finflow-ui",
      "name": "FinFlow Web UI",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "redirectUris": [
        "http://localhost:3000/*"
      ],
      "webOrigins": [
        "http://localhost:3000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "multivalued": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String"
          }
        },
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String"
          }
        },
        {
          "name": "email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "user.attribute": "email",
            "claim.name": "email",
            "jsonType.label": "String"
          }
        },
        {
          "name": "full name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-full-name-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "id": "aaaaaaaa-0000-0000-0000-000000000001",
      "username": "alice",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Sharma",
      "email": "alice@finflow.dev",
      "credentials": [
        {
          "type": "password",
          "value": "alice123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "USER"
      ]
    },
    {
      "id": "aaaaaaaa-0000-0000-0000-000000000002",
      "username": "bob",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Verma",
      "email": "bob@finflow.dev",
      "credentials": [
        {
          "type": "password",
          "value": "bob123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "USER"
      ]
    },
    {
      "id": "aaaaaaaa-0000-0000-0000-000000000003",
      "username": "merchant",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Bangalore",
      "lastName": "Coffee Co.",
      "email": "merchant@finflow.dev",
      "credentials": [
        {
          "type": "password",
          "value": "merchant123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "USER",
        "MERCHANT"
      ]
    },
    {
      "id": "aaaaaaaa-0000-0000-0000-000000000004",
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Ops",
      "lastName": "Admin",
      "email": "admin@finflow.dev",
      "credentials": [
        {
          "type": "password",
          "value": "admin123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "USER",
        "ADMIN"
      ]
    }
  ]
}